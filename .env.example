# ===== 案件管理システム 環境変数サンプル =====
# 使い方: このファイルを ".env" という名前でコピーし、値を編集してください。
#   cp .env.example .env

# セッションの暗号化に使う秘密鍵。必ず推測されない長いランダム文字列に変更してください。
# 生成例(Linux/Mac): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-long-random-string

# 待ち受けポート（社内で他アプリと衝突する場合のみ変更）
APP_PORT=8000

# タイムゾーン（作成日時などの表示に使用）
TZ=Asia/Tokyo
