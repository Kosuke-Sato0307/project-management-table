# ===== 案件管理システム 環境変数サンプル =====
# 使い方: このファイルを ".env" という名前でコピーし、値を編集してください。
#   cp .env.example .env

# セッションの暗号化に使う秘密鍵。必ず推測されない長いランダム文字列に変更してください。
# 生成例(Linux/Mac): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-long-random-string

# HTTPSの待ち受けポート。既定は443（URLにポート番号が不要）。
# 443が使えない/他と衝突する場合は 8443 などに変更し、https://<サーバ>:8443 でアクセス。
HTTPS_PORT=443

# 自己署名証明書に登録するホスト名/IP（実際にアクセスに使う値を、カンマ区切り・空白なしで）。
# 社内の他PCからアクセスさせる場合は、サーバのIPやホスト名を必ず入れてください。
# 例: localhost,192.168.1.10,pm-server
CERT_HOSTS=localhost

# タイムゾーン（作成日時などの表示に使用）
TZ=Asia/Tokyo
